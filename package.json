{
  "name": "massaman-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "massaman — a comprehensive functional programming library and utilities for TypeScript",
  "type": "module",
  "imports": {
    "#site/*": "./.ciderpress/*.ts"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fix": "turbo run format:fix lint:fix",
    "docs:sync": "zx scripts/docs-sync.mjs",
    "docs:sync:check": "zx scripts/docs-sync.mjs --check",
    "docs:stub-originals": "zx scripts/docs-stub-originals.mjs",
    "docs:dev": "node node_modules/ciderpress/dist/cli.mjs dev",
    "docs:build": "node node_modules/ciderpress/dist/cli.mjs build && node scripts/docs-base.mjs",
    "docs:check": "node node_modules/ciderpress/dist/cli.mjs check",
    "docs:serve": "node node_modules/ciderpress/dist/cli.mjs serve",
    "validate": "turbo run typecheck test && pnpm lint && pnpm format:check && pnpm docs:sync:check",
    "clean": "turbo run clean:build clean:turbo clean:npm && pnpm clean:docs-cache",
    "clean:turbo": "pnpm dlx rimraf -g '**/.turbo'",
    "clean:npm": "pnpm dlx rimraf -g '**/node_modules'",
    "clean:build": "pnpm dlx rimraf -g '**/dist' '**/*.tsbuildinfo'",
    "clean:docs-cache": "pnpm dlx rimraf '.cache' 'node_modules/.cache/docs-sync'",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@ciderpress/theme": "1.0.0-rc.5",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@types/node": "catalog:",
    "ciderpress": "1.0.0-rc.12",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-security": "^4.0.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "rimraf": "^6.1.3",
    "ts-pattern": "catalog:",
    "tsx": "catalog:",
    "turbo": "^2.10.10",
    "typescript": "^6.0.3",
    "vitest": "catalog:",
    "zx": "^8.8.5"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
